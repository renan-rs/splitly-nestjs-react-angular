{
  "openapi": "3.0.0",
  "paths": {
    "/api/v1/auth/csrf": {
      "get": {
        "operationId": "AuthController_issueCsrf",
        "parameters": [],
        "responses": {
          "204": {
            "description": "The XSRF-TOKEN cookie was set."
          },
          "429": {
            "description": "Rate limit exceeded."
          }
        },
        "summary": "Issue the XSRF-TOKEN cookie to echo in the X-XSRF-TOKEN header.",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "operationId": "AuthController_register",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserDto"
                }
              }
            }
          },
          "403": {
            "description": "Missing or invalid CSRF token."
          },
          "429": {
            "description": "Rate limit exceeded."
          }
        },
        "summary": "Create an account and start a session.",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "operationId": "AuthController_login",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserDto"
                }
              }
            }
          },
          "401": {
            "description": "Invalid email or password."
          },
          "403": {
            "description": "Missing or invalid CSRF token."
          },
          "429": {
            "description": "Rate limit exceeded."
          }
        },
        "summary": "Log in with email and password.",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "operationId": "AuthController_refresh",
        "parameters": [],
        "responses": {
          "204": {
            "description": "New cookies were set."
          },
          "401": {
            "description": "Invalid, expired or reused refresh token."
          },
          "403": {
            "description": "Missing or invalid CSRF token."
          },
          "429": {
            "description": "Rate limit exceeded."
          }
        },
        "summary": "Rotate the refresh token and issue a new access token.",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "AuthController_logout",
        "parameters": [],
        "responses": {
          "204": {
            "description": "The session is ended and cookies are cleared."
          },
          "403": {
            "description": "Missing or invalid CSRF token."
          },
          "429": {
            "description": "Rate limit exceeded."
          }
        },
        "summary": "Revoke the current session. Idempotent.",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/logout-all": {
      "post": {
        "operationId": "AuthController_logoutAll",
        "parameters": [],
        "responses": {
          "204": {
            "description": "All sessions are revoked and cookies are cleared."
          },
          "401": {
            "description": "Not authenticated."
          },
          "403": {
            "description": "Missing or invalid CSRF token."
          },
          "429": {
            "description": "Rate limit exceeded."
          }
        },
        "security": [
          {
            "cookie": []
          }
        ],
        "summary": "Revoke every session of the current user.",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "operationId": "AuthController_me",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserDto"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated."
          },
          "429": {
            "description": "Rate limit exceeded."
          }
        },
        "security": [
          {
            "cookie": []
          }
        ],
        "summary": "The authenticated user.",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/health": {
      "get": {
        "operationId": "HealthController_check",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponseDto"
                }
              }
            }
          },
          "503": {
            "description": "The database is unreachable."
          }
        },
        "tags": [
          "health"
        ]
      }
    }
  },
  "info": {
    "title": "Splitly API",
    "description": "Group expense splitting API.",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "access_token"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Ada Lovelace",
            "maxLength": 80
          },
          "email": {
            "type": "string",
            "example": "ada@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128,
            "format": "password"
          }
        },
        "required": [
          "name",
          "email",
          "password"
        ]
      },
      "UserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "email",
          "createdAt"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "ada@example.com"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "format": "password"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "HealthResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          },
          "database": {
            "type": "string",
            "example": "up"
          }
        },
        "required": [
          "status",
          "database"
        ]
      }
    }
  }
}
