# Used by docker-compose.yml. Copy to .env and choose a password.
# Keep it equal to the password in apps/api/.env (DATABASE_URL) when running the API outside Docker.
POSTGRES_PASSWORD=change-me
# API secrets for docker compose (at least 32 characters each). Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-at-least-32-chars
CSRF_SECRET=replace-with-another-long-random-secret-32-chars
