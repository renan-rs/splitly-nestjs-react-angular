NODE_ENV=development
PORT=3000
# Matches docker-compose.yml: user and database "splitly", port 5432.
# The password must equal POSTGRES_PASSWORD in the root .env (see the root .env.example).
DATABASE_URL="postgresql://splitly:change-me@localhost:5432/splitly?schema=public"
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://localhost:4200
LOG_LEVEL=info
# Secrets (at least 32 characters each). Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-at-least-32-chars
CSRF_SECRET=replace-with-another-long-random-secret-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
# Defaults to true when NODE_ENV=production
# COOKIE_SECURE=false
# Express "trust proxy": false | true | hop count | CIDR list. Set it behind a reverse proxy
# so rate limiting sees the real client IP.
TRUST_PROXY=false
